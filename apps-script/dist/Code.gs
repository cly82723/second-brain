var SCHOOL_SPECS = [KINGS_COLLEGE_2026, KTGSS_2026, OTHER_SCHOOL];
var DEFAULT_SCHOOL_ID = OTHER_SCHOOL.id;

function listSchools_() {
  return SCHOOL_SPECS.map(function (s) {
    return { id: s.id, name: s.name, year: s.year, kind: s.kind, cycleLength: s.cycleLength };
  });
}

function schoolSpec_(id) {
  for (var i = 0; i < SCHOOL_SPECS.length; i++) if (SCHOOL_SPECS[i].id === id) return SCHOOL_SPECS[i];
  return null;
}

var builtSchools_ = {};

// What the page and the email use: every cycle day and label worked out by date.
function buildSchool_(id) {
  var spec = schoolSpec_(id) || OTHER_SCHOOL;
  if (builtSchools_[spec.id]) return builtSchools_[spec.id];
  var school = {
    id: spec.id, name: spec.name, year: spec.year, kind: spec.kind,
    cycleLength: spec.cycleLength, first: spec.first || "", last: spec.last || "",
    cycleDays: spec.kind === "cycle" ? countCycleDays_(spec) : {},
    labels: spec.labels ? expandLabels_(spec.labels) : {}
  };
  builtSchools_[spec.id] = school;
  return school;
}

function countCycleDays_(spec) {
  var L = logic_();
  var skip = {};
  spec.noCycle.forEach(function (d) { skip[d] = true; });
  var days = {};
  var count = 0;
  for (var d = spec.cycleFrom; d <= spec.cycleTo; d = L.addDays(d, 1)) {
    var wd = L.weekday(d);
    if (wd === 0 || wd === 6 || skip[d]) continue;
    days[d] = (count % spec.cycleLength) + 1;
    count++;
  }
  return days;
}

function expandLabels_(ranges) {
  var L = logic_();
  var byDate = {};
  ranges.forEach(function (r) {
    for (var d = r[0]; d <= r[1]; d = L.addDays(d, 1)) {
      var wd = L.weekday(d);
      if (r[4] && (wd === 0 || wd === 6)) continue;
      (byDate[d] = byDate[d] || []).push({ text: r[2], type: r[3] });
    }
  });
  return byDate;
}

// ===== apps-script/Validate.gs =====
/* Checks everything the page sends before it reaches the Sheet. Anything wrong throws a UserError_
   with a message a teacher can act on. */

var LIMITS = {
  text: 4000, title: 200, className: 40, classes: 40, periods: 20, events: 2000, todos: 3000, importRows: 5000,
  categories: 20, categoryName: 30, marks: 2000, students: 60, studentName: 60, scripts: 500
};
var HAND_IN = ["S", "L", "A", "M", ""]; // Submitted, Late, Absent/excused, Missing, not yet recorded
var DEFAULT_CATEGORIES = [
  { id: "admin", name: "Admin", colour: "sky" },
  { id: "prep", name: "Lesson prep", colour: "sage" },
  { id: "meetings", name: "Meetings", colour: "lilac" },
  { id: "duties", name: "Duties", colour: "apricot" },
  { id: "personal", name: "Personal", colour: "rose" }
];
var CLASS_COLOURS = ["sage", "sky", "apricot", "lilac", "rose", "butter", "teal", "clay"];
var ID_PATTERN = /^[A-Za-z0-9_-]{2,48}$/;
var PERIOD_ID_PATTERN = /^[A-Za-z0-9]{1,8}$/;
var EMAIL_HOURS = [16, 17, 18, 19, 20, 21, 22, 23];

function UserError_(message) { this.message = message; }

function text_(value, max, what) {
  if (value === undefined || value === null) return "";
  if (typeof value !== "string") throw new UserError_(what + " must be text.");
  var trimmed = value.replace(/\r\n/g, "\n").trim();
  if (trimmed.length > max) throw new UserError_(what + " is too long (" + max + " characters at most).");
  return trimmed;
}

function requiredText_(value, max, what) {
  var t = text_(value, max, what);
  if (!t) throw new UserError_("Please fill in " + what.toLowerCase() + ".");
  return t;
}

function optionalDate_(value, what) {
  if (value === undefined || value === null || value === "") return "";
  if (!logic_().isDate(value)) throw new UserError_(what + " isn't a valid date.");
  return value;
}

function requiredDate_(value, what) {
  var d = optionalDate_(value, what);
  if (!d) throw new UserError_("Please choose " + what.toLowerCase() + ".");
  return d;
}

function optionalTime_(value, what) {
  if (value === undefined || value === null || value === "") return "";
  if (!logic_().isTime(value)) throw new UserError_(what + " isn't a valid time.");
  return value;
}

function cleanId_(value) {
  return typeof value === "string" && ID_PATTERN.test(value) ? value : "";
}

function newId_() {
  return Utilities.getUuid().replace(/-/g, "").slice(0, 16);
}

function cleanPeriods_(periods) {
  if (!Array.isArray(periods) || !periods.length) throw new UserError_("Please add at least one period.");
  if (periods.length > LIMITS.periods) throw new UserError_("That's more periods than the app allows (" + LIMITS.periods + ").");
  var seen = Object.create(null);
  var clean = periods.map(function (p) {
    var id = p && typeof p.id === "string" && PERIOD_ID_PATTERN.test(p.id) ? p.id : "";
    if (!id || seen[id]) throw new UserError_("Each period needs its own short code, like P1.");
    seen[id] = true;
    var label = requiredText_(p.label, 20, "Period name");
    var start = optionalTime_(p.start, label + " start");
    var end = optionalTime_(p.end, label + " end");
    if (!start || !end || start >= end) throw new UserError_(label + " needs a start time before its end time.");
    return { id: id, label: label, start: start, end: end, teaching: !!p.teaching };
  });
  return clean.sort(function (a, b) { return a.start < b.start ? -1 : 1; });
}

function cleanClasses_(classes) {
  if (!Array.isArray(classes)) throw new UserError_("The class list didn't arrive. Please try again.");
  if (classes.length > LIMITS.classes) throw new UserError_("That's more classes than the app allows (" + LIMITS.classes + ").");
  var names = Object.create(null);
  return classes.map(function (c) {
    var id = cleanId_(c && c.id);
    if (!id) throw new UserError_("A class is missing its id. Please reload the page and try again.");
    var name = requiredText_(c.name, LIMITS.className, "Class name");
    var key = name.toLowerCase();
    if (names[key]) throw new UserError_("There are two classes called " + name + ". Please give them different names.");
    names[key] = true;
    var colour = CLASS_COLOURS.indexOf(c.colour) >= 0 ? c.colour : CLASS_COLOURS[0];
    return { id: id, name: name, colour: colour };
  });
}

function cleanTimetable_(slots, periods, classes, cycleLength) {
  if (!Array.isArray(slots)) throw new UserError_("The timetable didn't arrive. Please try again.");
  var teaching = Object.create(null);
  periods.forEach(function (p) { if (p.teaching) teaching[p.id] = true; });
  var classIds = Object.create(null);
  classes.forEach(function (c) { classIds[c.id] = true; });
  var taken = Object.create(null);
  return slots
    .filter(function (s) { return s && s.classId; })
    .map(function (s) {
      var day = Number(s.day);
      if (!(day >= 1 && day <= cycleLength) || !teaching[s.period] || !classIds[s.classId]) {
        throw new UserError_("Part of the timetable doesn't match your periods or classes. Please check it and save again.");
      }
      var key = day + "|" + s.period;
      if (taken[key]) throw new UserError_("Two classes are in the same period. Please keep one per period.");
      taken[key] = true;
      return { day: day, period: s.period, classId: s.classId };
    });
}

function cleanLogEntry_(e, classIds) {
  if (!e || typeof e !== "object") throw new UserError_("That entry didn't arrive. Please try again.");
  var date = requiredDate_(e.date, "The lesson date");
  if (!classIds[e.classId]) throw new UserError_("That class isn't in your timetable any more. Please reload the page.");
  var followUp = text_(e.followUp, LIMITS.text, "Follow up");
  return {
    date: date,
    classId: e.classId,
    plan: text_(e.plan, LIMITS.text, "Plan"),
    covered: text_(e.covered, LIMITS.text, "Covered"),
    followUp: followUp,
    followUpDone: !!followUp && !!e.followUpDone,
    remind: text_(e.remind, LIMITS.text, "Remind students"),
    homework: text_(e.homework, LIMITS.text, "Homework"),
    homeworkDue: optionalDate_(e.homeworkDue, "Homework due date"),
    notes: text_(e.notes, LIMITS.text, "Notes"),
    done: !!e.done
  };
}

function cleanCategories_(list) {
  if (!Array.isArray(list)) throw new UserError_("The category list didn't arrive. Please try again.");
  if (list.length > LIMITS.categories) throw new UserError_("That's more categories than the app allows (" + LIMITS.categories + ").");
  var ids = Object.create(null);
  var names = Object.create(null);
  return list.map(function (c) {
    var id = cleanId_(c && c.id);
    if (!id || ids[id]) throw new UserError_("A category is missing its id. Please reload the page and try again.");
    ids[id] = true;
    var name = requiredText_(c.name, LIMITS.categoryName, "Category name");
    if (names[name.toLowerCase()]) throw new UserError_("There are two categories called " + name + ".");
    names[name.toLowerCase()] = true;
    return { id: id, name: name, colour: CLASS_COLOURS.indexOf(c.colour) >= 0 ? c.colour : CLASS_COLOURS[0] };
  });
}

// One class's name list: [{no, name}], class numbers unique.
function cleanRoster_(list) {
  if (!Array.isArray(list)) throw new UserError_("The name list didn't arrive. Please try again.");
  if (list.length > LIMITS.students) throw new UserError_("A class can have at most " + LIMITS.students + " students here.");
  var seen = Object.create(null);
  return list.map(function (s) {
    var no = Number(s && s.no);
    if (!(no >= 1 && no <= 99 && Math.floor(no) === no)) throw new UserError_("Each student needs a class number from 1 to 99.");
    if (seen[no]) throw new UserError_("Class number " + no + " appears twice in the list.");
    seen[no] = true;
    return { no: no, name: requiredText_(s.name, LIMITS.studentName, "Student " + no + "'s name") };
  }).sort(function (a, b) { return a.no - b.no; });
}

function cleanHandIns_(students) {
  if (students === undefined || students === null || students === "") return {};
  if (typeof students !== "object" || Array.isArray(students)) throw new UserError_("The hand-in list didn't arrive properly. Please try again.");
  var keys = Object.keys(students);
  if (keys.length > LIMITS.students) throw new UserError_("That's more students than the app allows (" + LIMITS.students + ").");
  var clean = {};
  keys.forEach(function (k) {
    if (!/^\d{1,2}$/.test(k)) throw new UserError_("The hand-in list has a bad class number.");
    var v = students[k] || {};
    clean[k] = { s: HAND_IN.indexOf(v.s) >= 0 ? v.s : "", m: !!v.m };
  });
  return clean;
}

function cleanCount_(value, what) {
  if (value === undefined || value === null || value === "") return "";
  var n = Number(value);
  if (!(n >= 0 && n <= LIMITS.scripts && Math.floor(n) === n)) throw new UserError_(what + " must be a whole number from 0 to " + LIMITS.scripts + ".");
  return n;
}

function cleanMark_(m, classIds, today) {
  if (!m || typeof m !== "object") throw new UserError_("That marking item didn't arrive. Please try again.");
  var classId = m.classId && classIds[m.classId] ? m.classId : "";
  var done = !!m.done;
  var scripts = cleanCount_(m.scripts, "Number of scripts");
  var marked = cleanCount_(m.marked, "Number marked");
  if (scripts !== "" && marked !== "" && marked > scripts) throw new UserError_("You can't have marked more scripts than there are.");
  var homework = typeof m.homework === "string" && /^\d{4}-\d{2}-\d{2}\|[A-Za-z0-9_-]{2,48}$/.test(m.homework) ? m.homework : "";
  return {
    id: cleanId_(m.id) || newId_(),
    title: requiredText_(m.title, LIMITS.title, "What to mark"),
    classId: classId,
    collected: optionalDate_(m.collected, "The date collected"),
    due: optionalDate_(m.due, "The return-by date"),
    scripts: scripts, marked: marked,
    notes: text_(m.notes, LIMITS.text, "Notes"),
    done: done,
    doneAt: done ? (optionalDate_(m.doneAt, "Done date") || today) : "",
    homework: homework,
    students: classId ? cleanHandIns_(m.students) : {},
    sheetCol: "" // only ever set by the web app itself, after writing to a scoresheet
  };
}

function cleanEvent_(ev, cycleLength) {
  if (!ev || typeof ev !== "object") throw new UserError_("That event didn't arrive. Please try again.");
  var date = requiredDate_(ev.date, "The date");
  var start = optionalTime_(ev.start, "Start time");
  var end = optionalTime_(ev.end, "End time");
  if (end && !start) throw new UserError_("Please add a start time, or clear the end time for an all-day event.");
  if (start && end && end <= start) throw new UserError_("The end time must be after the start time.");
  var repeat = ["none", "weekly", "cycle"].indexOf(ev.repeat) >= 0 ? ev.repeat : "none";
  var repeatOn = "";
  if (repeat === "cycle") {
    repeatOn = Number(ev.repeatOn);
    if (!(repeatOn >= 1 && repeatOn <= cycleLength)) throw new UserError_("Please choose which cycle day it repeats on.");
  }
  var until = repeat === "none" ? "" : optionalDate_(ev.until, "The end date");
  if (until && until < date) throw new UserError_("The repeat must end on or after the first date.");
  return {
    id: cleanId_(ev.id) || newId_(),
    title: requiredText_(ev.title, LIMITS.title, "Title"),
    date: date, start: start, end: end, repeat: repeat, repeatOn: repeatOn, until: until,
    replaces: !!ev.replaces,
    notes: text_(ev.notes, LIMITS.text, "Notes")
  };
}

// categoryIds: the notebook's categories; a category that has since been deleted is dropped.
function cleanTodo_(t, classIds, today, categoryIds) {
  if (!t || typeof t !== "object") throw new UserError_("That to-do didn't arrive. Please try again.");
  var due = optionalDate_(t.due, "The due date");
  var classId = t.classId && classIds[t.classId] ? t.classId : "";
  var category = t.category && categoryIds && categoryIds[t.category] ? t.category : "";
  var done = !!t.done;
  return {
    id: cleanId_(t.id) || newId_(),
    title: requiredText_(t.title, LIMITS.title, "The to-do"),
    due: due,
    time: due ? optionalTime_(t.time, "Time") : "",
    classId: classId,
    notes: text_(t.notes, LIMITS.text, "Notes"),
    done: done,
    doneAt: done ? (optionalDate_(t.doneAt, "Done date") || today) : "",
    category: category
  };
}

// ===== apps-script/Store.gs =====
/* The notes live in a Google Sheet in the owner's Drive, created the first time the app is used.
   The web app runs as its owner, so this is always the owner's Sheet; its ID is kept in the script's
   properties. The owner may look at the Sheet, but should change things in the app. */

var DATA_FILE_NAME = "Teachers' Second Brain – my data (please edit in the app)";
var SHEET_ID_KEY = "dataSheetId";

var TABS = {
  Settings: { headers: ["Key", "Value"], fields: ["key", "value"] },
  Classes: { headers: ["Id", "Name", "Colour"], fields: ["id", "name", "colour"] },
  Timetable: { headers: ["Day", "Period", "Class Id"], fields: ["day", "period", "classId"] },
  // New columns go on the end, so Sheets made by older versions keep working (see syncHeaders_).
  Log: {
    headers: ["Date", "Class Id", "Plan", "Remind students", "Homework", "Homework due", "Notes", "Done", "Updated",
      "Covered", "Follow up next lesson", "Follow-up done"],
    fields: ["date", "classId", "plan", "remind", "homework", "homeworkDue", "notes", "done", "updated",
      "covered", "followUp", "followUpDone"]
  },
  Events: {
    headers: ["Id", "Title", "Date", "Start", "End", "Repeat", "Repeat on", "Until", "Replaces lessons", "Notes"],
    fields: ["id", "title", "date", "start", "end", "repeat", "repeatOn", "until", "replaces", "notes"]
  },
  Todos: {
    headers: ["Id", "Title", "Due", "Time", "Class Id", "Notes", "Done", "Done on", "Category"],
    fields: ["id", "title", "due", "time", "classId", "notes", "done", "doneAt", "category"]
  },
  Marks: {
    headers: ["Id", "What", "Class Id", "Collected", "Return by", "Scripts", "Marked", "Notes", "Done", "Done on",
      "From homework", "Students (app use)", "Scoresheet column"],
    fields: ["id", "title", "classId", "collected", "due", "scripts", "marked", "notes", "done", "doneAt",
      "homework", "students", "sheetCol"]
  },
  Students: { headers: ["Class Id", "No.", "Name"], fields: ["classId", "no", "name"] }
};
var NUMBER_FIELDS = { day: true, repeatOn: true, scripts: true, marked: true, no: true };
var BOOLEAN_FIELDS = { done: true, replaces: true, followUpDone: true };
// Kept in one cell as JSON: {classNo: {s: "S"|"L"|"A"|"M"|"", m: true|false}}.
var JSON_FIELDS = { students: true };

// The owner's Sheet keeps the original property name, so existing data is found unchanged.
function sheetIdKeyFor_(notebook) {
  return notebook.owner ? SHEET_ID_KEY : SHEET_ID_KEY + ":" + notebook.id;
}

// Notebooks that have been opened at least once (so checking them never creates a Sheet).
function notebooksWithData_() {
  var props = PropertiesService.getScriptProperties();
  return allNotebooks_().filter(function (nb) { return !!props.getProperty(sheetIdKeyFor_(nb)); });
}

function book_() {
  var props = PropertiesService.getScriptProperties();
  var idKey = sheetIdKeyFor_(currentNotebook_);
  var id = props.getProperty(idKey);
  if (id) {
    var opened = openDataSheet_(id);
    if (opened) return opened;
  }
  // Creating is done under the script lock, so two pages opened at once can't make two sheets.
  var lock = LockService.getScriptLock();
  var hadLock = lock.hasLock();
  if (!hadLock) lock.waitLock(20000);
  try {
    var again = props.getProperty(idKey);
    if (again && again !== id) return openDataSheet_(again) || createDataSheet_(props, idKey);
    return createDataSheet_(props, idKey);
  } finally {
    if (!hadLock) lock.releaseLock();
  }
}

// Null only when the sheet is definitely gone (deleted, or no longer shared with this account).
// Any other failure is usually a passing hiccup at Google, so the teacher is asked to retry
// instead of being moved to an empty sheet.
function openDataSheet_(id) {
  try {
    return SpreadsheetApp.openById(id);
  } catch (e) {
    var message = String(e && e.message || e);
    if (/not found|no item|does not exist|permission/i.test(message)) {
      console.warn("Data sheet " + id + " is gone, so a new one is being made: " + message);
      return null;
    }
    console.error("Data sheet " + id + " could not be opened: " + message);
    throw new UserError_("Google couldn't open your data just now. Please try again in a moment.");
  }
}

function createDataSheet_(props, idKey) {
  var name = currentNotebook_.owner ? DATA_FILE_NAME : DATA_FILE_NAME + " – " + currentNotebook_.name;
  var book = SpreadsheetApp.create(name);
  Object.keys(TABS).forEach(function (tabName, i) {
    var sheet = i === 0 ? book.getSheets()[0].setName(tabName) : book.insertSheet(tabName);
    addHeaders_(sheet, tabName);
  });
  props.setProperty(idKey, book.getId());
  return book;
}

function addHeaders_(sheet, name) {
  sheet.appendRow(TABS[name].headers);
  sheet.setFrozenRows(1);
  sheet.getRange(1, 1, 1, TABS[name].headers.length).setFontWeight("bold");
}

var syncedTabs_ = {};

function tab_(name) {
  var book = book_();
  var sheet = book.getSheetByName(name);
  if (!sheet) {
    sheet = book.insertSheet(name);
    addHeaders_(sheet, name);
  } else {
    syncHeaders_(book, sheet, name);
  }
  return sheet;
}

// A Sheet made before a column was added gets the new header names, once per run.
function syncHeaders_(book, sheet, name) {
  var key = book.getId() + "|" + name;
  if (syncedTabs_[key]) return;
  syncedTabs_[key] = true;
  var headers = TABS[name].headers;
  var current = sheet.getRange(1, 1, 1, headers.length).getValues()[0];
  if (current.some(function (v, i) { return v !== headers[i]; })) {
    sheet.getRange(1, 1, 1, headers.length).setValues([headers]).setFontWeight("bold");
  }
}

function fromCell_(field, value) {
  if (BOOLEAN_FIELDS[field]) return value === true || value === "yes" || value === "TRUE";
  if (JSON_FIELDS[field]) {
    if (!value) return {};
    try { var parsed = JSON.parse(String(value)); return parsed && typeof parsed === "object" && !Array.isArray(parsed) ? parsed : {}; }
    catch (e) { return {}; }
  }
  if (value instanceof Date) {
    var format = field === "start" || field === "end" || field === "time" ? "HH:mm" : "yyyy-MM-dd";
    return Utilities.formatDate(value, Session.getScriptTimeZone(), format);
  }
  if (NUMBER_FIELDS[field]) return value === "" ? "" : Number(value);
  return value === null || value === undefined ? "" : String(value);
}

// A leading apostrophe keeps Sheets from turning "2026-11-05" into a date or "=..." into a formula.
function toCell_(field, value) {
  if (BOOLEAN_FIELDS[field]) return value ? "yes" : "";
  if (JSON_FIELDS[field]) return value && Object.keys(value).length ? "'" + JSON.stringify(value) : "";
  if (value === "" || value === null || value === undefined) return "";
  return "'" + String(value);
}

function isBlankRow_(row) { return !row.some(function (v) { return v !== ""; }); }

function rowObject_(fields, row) {
  var obj = {};
  fields.forEach(function (f, i) { obj[f] = fromCell_(f, row[i] === undefined ? "" : row[i]); });
  return obj;
}

function readTab_(name) {
  var fields = TABS[name].fields;
  return tab_(name).getDataRange().getValues().slice(1)
    .filter(function (row) { return !isBlankRow_(row); })
    .map(function (row) { return rowObject_(fields, row); });
}

function toRow_(name, obj) {
  return TABS[name].fields.map(function (f) { return toCell_(f, obj[f]); });
}

// Writes the new rows first and only then trims what's left over, so a failure part-way
// never leaves the tab empty.
function replaceTab_(name, objects) {
  var sheet = tab_(name);
  var width = TABS[name].fields.length;
  if (objects.length) {
    sheet.getRange(2, 1, objects.length, width).setValues(objects.map(function (o) { return toRow_(name, o); }));
  }
  var last = sheet.getLastRow();
  var keep = objects.length + 1;
  if (last > keep) sheet.deleteRows(keep + 1, last - keep);
}

// Real sheet row numbers, counting any blank rows someone left in the Sheet.
function findRow_(name, keyOf, key) {
  var fields = TABS[name].fields;
  var rows = tab_(name).getDataRange().getValues();
  for (var i = 1; i < rows.length; i++) {
    if (!isBlankRow_(rows[i]) && keyOf(rowObject_(fields, rows[i])) === key) return i + 1;
  }
  return 0;
}

function upsert_(name, keyOf, obj) {
  var sheet = tab_(name);
  var row = findRow_(name, keyOf, keyOf(obj));
  if (row) sheet.getRange(row, 1, 1, TABS[name].fields.length).setValues([toRow_(name, obj)]);
  else sheet.appendRow(toRow_(name, obj));
  return obj;
}

function remove_(name, keyOf, key) {
  var row = findRow_(name, keyOf, key);
  if (row) tab_(name).deleteRow(row);
  return !!row;
}

function readSettings_() {
  var settings = {};
  readTab_("Settings").forEach(function (r) {
    try {
      settings[r.key] = JSON.parse(r.value);
    } catch (e) {
      console.warn("Setting " + r.key + " is not valid JSON and was ignored.");
    }
  });
  return settings;
}

function writeSetting_(key, value) {
  upsert_("Settings", function (r) { return r.key; }, { key: key, value: JSON.stringify(value) });
}

function logKey_(e) { return e.date + "|" + e.classId; }
function idKey_(o) { return o.id; }

function dataSheetUrl_() {
  return book_().getUrl();
}

// ===== apps-script/Code.gs =====
/* Teachers' Second Brain: the web app the page (https://cly82723.github.io/second-brain/) talks to.
   Works like CLY English: deployed to run as its owner, open to anyone, no sign-in. Every request is a
   POST of {action, key, args} sent as text/plain (so the browser skips the CORS preflight Apps Script
   can't answer). The key is the secret code from the owner's personal link; without it, nothing is
   read or written. Notes live in a Google Sheet in the owner's Drive (Store.gs). Setup: README.md.

   Other teachers can have their own notebook on the same deployment (addTeacher below): each gets
   their own secret link and their own Sheet, also in the owner's Drive. The key picks the notebook. */

var APP_NAME = "Teachers' Second Brain";
var SITE_URL = "https://cly82723.github.io/second-brain/";
var ACCESS_KEY_PROP = "ACCESS_KEY";
var NOTEBOOKS_PROP = "NOTEBOOKS";
var OWNER_NOTEBOOK = { id: "owner", name: "", email: "", owner: true };
var EMAIL_PATTERN = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

// Whose notebook this request is for. Apps Script starts every request fresh, so this never leaks
// from one request into another. Functions run from the editor or a trigger start on the owner's.
var currentNotebook_ = OWNER_NOTEBOOK;

// To give another teacher their own notebook: fill in their name (and email, for the evening
// email), select addTeacher in the toolbar, press Run, and send them the link it logs.
// Running it again with the same name shows the same link (and updates the email).
var NEW_TEACHER = { name: "", email: "" };

// What the page may ask for. Each returns {ok, data} or {ok: false, error}.
function actionFor_(name) {
  var actions = {
    getAll: getAll, getDataSheetUrl: getDataSheetUrl, saveSetup: saveSetup, saveLog: saveLog,
    carryForward: carryForward, saveEvent: saveEvent, deleteEvent: deleteEvent, saveTodo: saveTodo,
    deleteTodo: deleteTodo, clearDoneTodos: clearDoneTodos, importData: importData,
    saveEmail: saveEmail, sendTestEmail: sendTestEmail, saveCategories: saveCategories,
    saveMark: saveMark, deleteMark: deleteMark, saveRoster: saveRoster,
    linkScoresheet: linkScoresheet, unlinkScoresheet: unlinkScoresheet,
    previewScoresheet: previewScoresheet, writeScoresheet: writeScoresheet
  };
  return Object.prototype.hasOwnProperty.call(actions, name) ? actions[name] : null;
}

function doGet() { return json_({ ok: true, service: APP_NAME }); }

function doPost(e) {
  var body;
  try {
    body = JSON.parse((e && e.postData && e.postData.contents) || "{}");
  } catch (err) {
    return json_({ ok: false, error: "That request didn't make sense. Please reload the page." });
  }
  var notebook = notebookForKey_(body.key);
  if (!notebook) {
    return json_({ ok: false, locked: true, error: "This notebook is private. Open your personal link to use it on this device." });
  }
  currentNotebook_ = notebook;
  var action = actionFor_(body.action);
  if (!action) return json_({ ok: false, error: "Unknown request. Please reload the page." });
  var args = Array.isArray(body.args) ? body.args : [];
  return json_(action.apply(null, args));
}

function json_(o) { return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON); }

// The owner's code, or one of the other teachers' codes. Every code is checked, so the time taken
// doesn't reveal which one (if any) came close.
function notebookForKey_(given) {
  var found = null;
  if (sameKey_(PropertiesService.getScriptProperties().getProperty(ACCESS_KEY_PROP), given)) found = OWNER_NOTEBOOK;
  readNotebooks_().forEach(function (nb) { if (sameKey_(nb.key, given)) found = guestNotebook_(nb); });
  return found;
}

// Compares in constant time, so a code can't be guessed a character at a time.
function sameKey_(key, given) {
  if (!key || typeof key !== "string" || typeof given !== "string" || given.length !== key.length) return false;
  var diff = 0;
  for (var i = 0; i < key.length; i++) diff |= key.charCodeAt(i) ^ given.charCodeAt(i);
  return diff === 0;
}

// The other teachers, kept in the script's properties as [{id, name, email, key}].
// Reading for a request, a damaged list just refuses the other teachers' links. Reading in order to
// change it (strict), it stops instead, so a typo can never be saved over everyone's links.
function readNotebooks_(strict) {
  var raw = PropertiesService.getScriptProperties().getProperty(NOTEBOOKS_PROP);
  if (!raw) return [];
  var list = null;
  try { list = JSON.parse(raw); } catch (e) { list = null; }
  if (!Array.isArray(list)) {
    if (strict) throw new Error("The NOTEBOOKS script property is damaged. Fix it in Project Settings → Script properties first; nothing was changed.");
    console.error("The NOTEBOOKS script property is damaged, so other teachers' links are refused until it's fixed.");
    return [];
  }
  return strict ? list : list.filter(function (nb) { return nb && typeof nb.id === "string" && typeof nb.key === "string"; });
}

// What a request knows about a notebook: never its key.
function guestNotebook_(nb) {
  return { id: nb.id, name: nb.name || "", email: nb.email || "", owner: false };
}

function allNotebooks_() {
  return [OWNER_NOTEBOOK].concat(readNotebooks_().map(guestNotebook_));
}

// Runs work as if the request had come from that notebook's link.
function withNotebook_(notebook, work) {
  var previous = currentNotebook_;
  currentNotebook_ = notebook;
  try {
    return work();
  } finally {
    currentNotebook_ = previous;
  }
}

// Where this notebook's evening email goes: the owner's own address, or the one given in addTeacher.
function recipient_() {
  return currentNotebook_.owner ? Session.getEffectiveUser().getEmail() : currentNotebook_.email;
}

// Run from the editor after filling in NEW_TEACHER above.
function addTeacher() {
  var link = addNotebook_(NEW_TEACHER.name, NEW_TEACHER.email);
  console.log("Personal link for " + String(NEW_TEACHER.name).trim() + " (send it only to them): " + link);
  return link;
}

function addNotebook_(name, email) {
  var cleanName = String(name || "").trim();
  var cleanEmail = String(email || "").trim();
  if (!cleanName) throw new Error("Fill in NEW_TEACHER's name first (near the top of the Code.gs part), then run addTeacher again.");
  if (cleanName.length > 60) throw new Error("NEW_TEACHER's name is too long (60 characters at most).");
  if (cleanEmail && !EMAIL_PATTERN.test(cleanEmail)) throw new Error("NEW_TEACHER's email doesn't look like an email address.");
  return withLock_(function () {
    var list = readNotebooks_(true);
    var existing = list.filter(function (nb) { return String(nb.name).toLowerCase() === cleanName.toLowerCase(); })[0];
    var updated;
    if (existing) {
      updated = list.map(function (nb) { return nb === existing && cleanEmail ? Object.assign({}, nb, { email: cleanEmail }) : nb; });
    } else {
      existing = { id: "t" + Utilities.getUuid().replace(/-/g, "").slice(0, 12), name: cleanName, email: cleanEmail, key: newAccessKey_() };
      updated = list.concat([existing]);
    }
    PropertiesService.getScriptProperties().setProperty(NOTEBOOKS_PROP, JSON.stringify(updated));
    return SITE_URL + "#k=" + existing.key;
  });
}

// Run from the editor to see every other teacher's personal link again.
function listTeachers() {
  var list = readNotebooks_(true);
  if (!list.length) console.log("No other teachers yet. Fill in NEW_TEACHER and run addTeacher.");
  list.forEach(function (nb) {
    console.log(nb.name + (nb.email ? " <" + nb.email + ">" : " (no email)") + ": " + SITE_URL + "#k=" + nb.key);
  });
  return list.map(function (nb) { return { name: nb.name, email: nb.email || "", link: SITE_URL + "#k=" + nb.key }; });
}

function newAccessKey_() {
  return (Utilities.getUuid() + Utilities.getUuid()).replace(/-/g, "");
}

// Run once from the editor (select createAccessKey, press Run): makes the secret code and logs your
// personal link. Running it again just shows the same link. Delete ACCESS_KEY in Project Settings →
// Script properties and run it again to make a new link (every device then needs the new one).
function createAccessKey() {
  var props = PropertiesService.getScriptProperties();
  var key = props.getProperty(ACCESS_KEY_PROP);
  if (!key) {
    key = newAccessKey_();
    props.setProperty(ACCESS_KEY_PROP, key);
  }
  var link = SITE_URL + "#k=" + key;
  console.log("Your personal link (keep it private): " + link);
  return link;
}

// Every action goes through here: {ok: true, data} or {ok: false, error} with a readable message.
function respond_(work) {
  try {
    return { ok: true, data: work() };
  } catch (e) {
    if (e instanceof UserError_) return { ok: false, error: e.message };
    console.error(e && e.stack ? e.stack : e);
    return { ok: false, error: "Something went wrong on Google's side. Please try again in a moment." };
  }
}

// One owner, many devices: a script-wide lock keeps two saves from interleaving.
function withLock_(work) {
  var lock = LockService.getScriptLock();
  lock.waitLock(20000);
  try {
    return work();
  } finally {
    lock.releaseLock();
  }
}

function today_() {
  return Utilities.formatDate(new Date(), Session.getScriptTimeZone(), "yyyy-MM-dd");
}

function allData_() {
  var settings = readSettings_();
  var schoolId = schoolSpec_(settings.schoolId) ? settings.schoolId : DEFAULT_SCHOOL_ID;
  var spec = schoolSpec_(schoolId);
  return {
    email: recipient_(),
    owner: currentNotebook_.owner,
    // The account the web app runs as: a scoresheet must be shared with it to be linked.
    ownerEmail: Session.getEffectiveUser().getEmail(),
    today: today_(),
    schools: listSchools_(),
    colours: CLASS_COLOURS,
    emailHours: EMAIL_HOURS,
    settings: {
      schoolId: schoolId,
      setupDone: !!settings.setupDone,
      startDate: settings.startDate || "",
      email: settings.email || { on: false, hour: 20 }
    },
    school: buildSchool_(schoolId),
    periods: settings.periods || spec.periods,
    categories: settings.categories || DEFAULT_CATEGORIES,
    classes: readTab_("Classes"),
    timetable: readTab_("Timetable"),
    log: readTab_("Log"),
    events: readTab_("Events"),
    todos: readTab_("Todos"),
    marks: readTab_("Marks"),
    rosters: rostersByClass_(),
    // Which classes have a scoresheet linked (the file id stays on the server).
    scoresheets: Object.keys(settings.scoresheets || {}).reduce(function (o, k) { o[k] = true; return o; }, {})
  };
}

function categoryIdSet_() {
  var ids = Object.create(null);
  (readSettings_().categories || DEFAULT_CATEGORIES).forEach(function (c) { ids[c.id] = true; });
  return ids;
}

function saveCategories(list) {
  return respond_(function () {
    return withLock_(function () {
      var clean = cleanCategories_(list);
      writeSetting_("categories", clean);
      return { categories: clean };
    });
  });
}

function context_() {
  return logic_().prepare(allData_());
}

// Prototype-free, so a name like "constructor" can't pass as a class id.
function classIdSet_() {
  var ids = Object.create(null);
  readTab_("Classes").forEach(function (c) { ids[c.id] = true; });
  return ids;
}

function getAll() {
  return respond_(allData_);
}

function getDataSheetUrl() {
  return respond_(function () {
    if (!currentNotebook_.owner) throw new UserError_("Your notes are kept in a Google Sheet looked after by the person who set up this app. Ask them if you need a copy.");
    return { url: dataSheetUrl_() };
  });
}

// School, periods, classes and timetable, all saved together.
function saveSetup(setup) {
  return respond_(function () {
    return withLock_(function () {
      writeSetup_(checkedSetup_(setup || {}));
      return allData_();
    });
  });
}

// Checks a setup without writing anything.
function checkedSetup_(setup) {
  var spec = schoolSpec_(setup.schoolId);
  if (!spec) throw new UserError_("Please choose your school.");
  var periods = cleanPeriods_(setup.periods);
  var classes = cleanClasses_(setup.classes);
  var timetable = cleanTimetable_(setup.timetable, periods, classes, spec.cycleLength);
  refuseRemovingLoggedClasses_(classes);
  return { spec: spec, periods: periods, classes: classes, timetable: timetable };
}

function writeSetup_(checked) {
  replaceTab_("Classes", checked.classes);
  replaceTab_("Timetable", checked.timetable);
  writeSetting_("schoolId", checked.spec.id);
  writeSetting_("periods", checked.periods);
  var settings = readSettings_();
  if (!settings.startDate) writeSetting_("startDate", today_());
  writeSetting_("setupDone", true);
}

function refuseRemovingLoggedClasses_(keptClasses) {
  var kept = Object.create(null);
  keptClasses.forEach(function (c) { kept[c.id] = true; });
  var names = Object.create(null);
  readTab_("Classes").forEach(function (c) { names[c.id] = c.name; });
  var removedWithEntries = Object.create(null);
  readTab_("Log").forEach(function (e) { if (!kept[e.classId] && names[e.classId]) removedWithEntries[names[e.classId]] = true; });
  var list = Object.keys(removedWithEntries);
  if (list.length) {
    throw new UserError_(list.join(", ") + " already has logbook entries, so it can't be deleted. " +
      "To stop it appearing, take it off the timetable instead.");
  }
}

function saveLog(entry) {
  return respond_(function () {
    return withLock_(function () { return { entry: writeLog_(cleanLogEntry_(entry, classIdSet_())) }; });
  });
}

// An entry with nothing in it is removed rather than kept as an empty row.
function writeLog_(clean) {
  if (!clean.done && !logic_().hasWriting(clean) && !clean.homeworkDue) {
    remove_("Log", logKey_, logKey_(clean));
    return null;
  }
  return upsert_("Log", logKey_, Object.assign({}, clean, { updated: today_() }));
}

// "Didn't finish": ticks this lesson and adds what's left to its follow-up, which then shows at the
// top of the class's next lesson until it's ticked off there.
function carryForward(request) {
  return respond_(function () {
    return withLock_(function () {
      var L = logic_();
      var ctx = context_();
      var current = cleanLogEntry_(request && request.entry, classIdSet_());
      var leftover = requiredText_(request && request.leftover, LIMITS.text, "What's left");
      var next = L.nextLesson(ctx, current.classId, current.date);
      if (!next) throw new UserError_("There's no later lesson with this class in the calendar to move it to.");
      var followUp = cleanLogEntry_(Object.assign({}, current, {
        followUp: current.followUp ? current.followUp + "\n" + leftover : leftover, followUpDone: false, done: true
      }), classIdSet_());
      return { current: writeLog_(followUp), nextDate: next.date };
    });
  });
}

function saveEvent(ev) {
  return respond_(function () {
    return withLock_(function () {
      var spec = schoolSpec_(readSettings_().schoolId) || schoolSpec_(DEFAULT_SCHOOL_ID);
      var clean = cleanEvent_(ev, spec.cycleLength);
      var isNew = !findRow_("Events", idKey_, clean.id);
      if (isNew && readTab_("Events").length >= LIMITS.events) throw new UserError_("You've reached the limit of " + LIMITS.events + " events.");
      return { event: upsert_("Events", idKey_, clean) };
    });
  });
}

function deleteEvent(id) {
  return respond_(function () {
    return withLock_(function () { return { removed: remove_("Events", idKey_, cleanId_(id)) }; });
  });
}

function saveTodo(todo) {
  return respond_(function () {
    return withLock_(function () {
      var clean = cleanTodo_(todo, classIdSet_(), today_(), categoryIdSet_());
      var isNew = !findRow_("Todos", idKey_, clean.id);
      if (isNew && readTab_("Todos").length >= LIMITS.todos) throw new UserError_("You've reached the limit of " + LIMITS.todos + " to-dos. Delete some finished ones first.");
      return { todo: upsert_("Todos", idKey_, clean) };
    });
  });
}

function deleteTodo(id) {
  return respond_(function () {
    return withLock_(function () { return { removed: remove_("Todos", idKey_, cleanId_(id)) }; });
  });
}

// Clears finished to-dos, so the list and the Sheet stay small.
function clearDoneTodos() {
  return respond_(function () {
    return withLock_(function () {
      var open = readTab_("Todos").filter(function (t) { return !t.done; });
      replaceTab_("Todos", open);
      return { todos: open };
    });
  });
}

// ===== apps-script/Import.gs =====
/* Brings in a setup file (made by tools/import-docx.js, or exported from another account).
   The whole file is checked before anything is written, so a bad file changes nothing.
   Entries already in the app are never overwritten: an imported entry for the same lesson is skipped. */

function importData(payload) {
  return respond_(function () {
    return withLock_(function () {
      if (!payload || typeof payload !== "object") throw new UserError_("That file doesn't look like a Teachers' Second Brain file.");
      var setup = payload.classes || payload.timetable ? importedSetup_(payload) : null;
      var classIds = Object.create(null);
      (setup ? setup.classes : readTab_("Classes")).forEach(function (c) { classIds[c.id] = true; });
      var spec = setup ? setup.spec : (schoolSpec_(readSettings_().schoolId) || schoolSpec_(DEFAULT_SCHOOL_ID));
      var plans = {
        Log: planMerge_("Log", logKey_, payload.log, function (e) { return cleanLogEntry_(e, classIds); }, LIMITS.importRows),
        Events: planMerge_("Events", idKey_, payload.events, function (e) { return cleanEvent_(e, spec.cycleLength); }, LIMITS.events),
        Todos: planMerge_("Todos", idKey_, payload.todos, function (t) { return cleanTodo_(t, classIds, today_(), categoryIdSet_()); }, LIMITS.todos)
      };
      // Everything checked: now write.
      if (setup) writeSetup_(setup);
      Object.keys(plans).forEach(function (tab) {
        if (plans[tab].added.length) replaceTab_(tab, plans[tab].existing.concat(plans[tab].added));
      });
      return {
        counts: {
          log: { added: plans.Log.added.length, skipped: plans.Log.skipped },
          events: { added: plans.Events.added.length, skipped: plans.Events.skipped },
          todos: { added: plans.Todos.added.length, skipped: plans.Todos.skipped }
        },
        data: allData_()
      };
    });
  });
}

function importedSetup_(payload) {
  var current = allData_();
  return checkedSetup_({
    schoolId: payload.schoolId || current.settings.schoolId,
    periods: payload.periods || current.periods,
    classes: payload.classes || current.classes,
    timetable: payload.timetable || current.timetable
  });
}

// Works out which rows would be added, without writing anything.
function planMerge_(tab, keyOf, incoming, clean, maxTotal) {
  var existing = readTab_(tab);
  if (incoming === undefined) return { existing: existing, added: [], skipped: 0 };
  if (!Array.isArray(incoming) || incoming.length > LIMITS.importRows) {
    throw new UserError_("The " + tab.toLowerCase() + " part of the file is too big or damaged.");
  }
  var seen = Object.create(null);
  existing.forEach(function (r) { seen[keyOf(r)] = true; });
  var added = [];
  var skipped = 0;
  incoming.forEach(function (raw) {
    try {
      var row = clean(raw);
      if (seen[keyOf(row)]) { skipped++; return; }
      seen[keyOf(row)] = true;
      added.push(tab === "Log" ? Object.assign({}, row, { updated: today_() }) : row);
    } catch (e) {
      if (!(e instanceof UserError_)) throw e;
      skipped++;
    }
  });
  if (existing.length + added.length > maxTotal) {
    throw new UserError_("Importing this would go over the limit of " + maxTotal + " " + tab.toLowerCase() + ". Nothing was imported.");
  }
  return { existing: existing, added: added, skipped: skipped };
}

// ===== apps-script/Email.gs =====
/* The evening round-up email. One hourly trigger (running as the owner) looks at every notebook
   and emails each one whose chosen hour it is, to that notebook's own address (recipient_). */

var DIGEST_HANDLER = "dailyDigest";
var NO_ADDRESS = "There's no email address for this notebook yet. Ask the person who set up the app to add one.";

function saveEmail(request) {
  return respond_(function () {
    return withLock_(function () {
      var on = !!(request && request.on);
      var hour = Number(request && request.hour);
      if (EMAIL_HOURS.indexOf(hour) < 0) throw new UserError_("Please pick a time between 4 pm and 11 pm.");
      if (on && !recipient_()) throw new UserError_(NO_ADDRESS);
      // Keeps the day it was last sent, so saving again after tonight's email doesn't send a second.
      var previous = readSettings_().email || {};
      var email = { on: on, hour: hour, lastSent: previous.lastSent || "" };
      writeSetting_("email", email);
      syncDigestTrigger_();
      return { email: email };
    });
  });
}

// Exactly one hourly trigger while anyone has the email on; none otherwise.
function syncDigestTrigger_() {
  ScriptApp.getProjectTriggers().forEach(function (t) {
    if (t.getHandlerFunction() === DIGEST_HANDLER) ScriptApp.deleteTrigger(t);
  });
  if (anyEmailOn_()) ScriptApp.newTrigger(DIGEST_HANDLER).timeBased().everyHours(1).create();
}

// A notebook that can't be read just now counts as on, so nobody's email is switched off by a hiccup.
function anyEmailOn_() {
  return notebooksWithData_().some(function (nb) {
    try {
      return withNotebook_(nb, function () { var e = readSettings_().email; return !!(e && e.on); });
    } catch (e) {
      console.warn("Couldn't check the evening email setting for " + (nb.name || "the owner") + ": " + (e && e.message || e));
      return true;
    }
  });
}

// Run by the hourly trigger. Each notebook is dealt with once a day, at the first run on or after its
// chosen hour (so a skipped trigger run only makes it later, never lost), and an email goes out only
// when tomorrow has something on. One notebook failing doesn't stop the others.
function dailyDigest() {
  var hour = Number(Utilities.formatDate(new Date(), Session.getScriptTimeZone(), "HH:mm").slice(0, 2));
  notebooksWithData_().forEach(function (nb) {
    try {
      withNotebook_(nb, function () { withLock_(function () { sendDigestIfDue_(hour); }); });
    } catch (e) {
      console.error("Evening email for " + (nb.name || "the owner") + " failed: " + (e && e.stack ? e.stack : e));
    }
  });
}

function sendDigestIfDue_(hour) {
  var settings = readSettings_();
  var email = settings.email;
  var today = today_();
  if (!email || !email.on || hour < Number(email.hour) || email.lastSent === today || !recipient_()) return;
  var ctx = context_();
  var digest = logic_().digest(ctx, today, settings.startDate || "");
  if (digest) sendDigest_(ctx, digest);
  writeSetting_("email", Object.assign({}, email, { lastSent: today }));
}

function sendTestEmail() {
  return respond_(function () {
    var to = recipient_();
    if (!to) throw new UserError_(NO_ADDRESS);
    var ctx = context_();
    var digest = logic_().digest(ctx, today_(), readSettings_().startDate || "");
    if (!digest) {
      MailApp.sendEmail({ to: to, subject: APP_NAME + ": test email", name: APP_NAME,
        body: "Your evening email works. Tomorrow has nothing on, so on a real evening like this one no email would be sent." });
    } else {
      sendDigest_(ctx, digest);
    }
    return { to: to };
  });
}

function sendDigest_(ctx, digest) {
  var mail = digestEmail_(ctx, digest, appUrl_());
  MailApp.sendEmail({ to: recipient_(), subject: mail.subject, htmlBody: mail.html, body: mail.text, name: APP_NAME });
}

// The plain site address, without the secret code: a forwarded email doesn't hand over access.
// Devices that have opened the personal link once remember the code.
function appUrl_() {
  return SITE_URL;
}

function esc_(s) {
  return String(s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
}

function multiline_(s) { return esc_(s).replace(/\n/g, "<br>"); }

// Builds the email as sections, each both HTML and plain text.
function digestEmail_(ctx, d, url) {
  var L = logic_();
  var dayName = d.info.cycleDay ? " · " + L.cycleName(ctx.school, d.info.cycleDay) : "";
  var count = d.lessons.filter(function (l) { return !l.replacedBy; }).length;
  var subject = "Tomorrow, " + L.shortDate(d.date) + dayName + ": " +
    (count ? count + (count === 1 ? " lesson" : " lessons") : "no lessons");
  var sections = [
    section_("Still to update from today", d.leftToday.map(function (l) {
      return { title: l.cls.name + " (" + l.periodText + ")" };
    })),
    section_("Lessons", d.lessons.map(function (l) { return lessonItem_(l); })),
    section_("Homework to collect", d.homeworkDue.map(function (h) {
      return { title: h.cls.name, lines: [["Set " + L.shortDate(h.entry.date), h.entry.homework]] };
    })),
    section_("Events", d.events.map(function (ev) {
      var when = ev.allDay ? "All day" : ev.start + (ev.end ? "–" + ev.end : "");
      return { title: ev.title, meta: when + (ev.replaces ? " · replaces lessons" : ""), lines: ev.notes ? [["Notes", ev.notes]] : [] };
    })),
    section_("Marking due", d.marksDue.concat(d.overdueMarks).map(function (m) {
      var p = L.markProgress(m);
      var cls = m.classId && ctx.classById[m.classId];
      return { title: m.title, meta: [cls ? cls.name : "", m.due < d.date ? "overdue, was due " + L.shortDate(m.due) : "",
        p.total ? p.marked + " of " + p.total + " marked" : ""].filter(Boolean).join(" · ") };
    })),
    section_("To-dos due tomorrow", d.todosDue.map(function (t) { return { title: t.title, meta: t.time || "" }; })),
    section_("Overdue to-dos", d.overdue.map(function (t) { return { title: t.title, meta: "was due " + L.shortDate(t.due) }; }))
  ].filter(Boolean);
  var heading = L.longDate(d.date) + dayName;
  var labels = d.info.labels.map(function (l) { return l.text; }).join(" · ");
  return {
    subject: subject,
    html: emailHtml_(heading, labels, sections, url),
    text: [heading, labels].concat(sections.map(function (s) { return s.text; }))
      .concat(url ? ["Open the app: " + url] : []).filter(Boolean).join("\n\n")
  };
}

function lessonItem_(l) {
  var e = l.entry || {};
  var lines = [];
  if (l.replacedBy) lines.push(["Replaced by", l.replacedBy.title]);
  (l.followUps || []).forEach(function (f) { lines.push(["Follow up (from " + logic_().shortDate(f.date) + ")", f.followUp]); });
  (l.collect || []).forEach(function (h) { lines.push(["Collect", h.homework + " (set " + logic_().shortDate(h.date) + ")"]); });
  if (e.plan) lines.push(["Plan", e.plan]);
  if (e.remind) lines.push(["Remind students", e.remind]);
  if (e.homework) lines.push(["Homework to give", e.homework + (e.homeworkDue ? " (due " + logic_().shortDate(e.homeworkDue) + ")" : "")]);
  if (!lines.length) lines.push(["Plan", "Nothing planned yet"]);
  return { title: l.cls.name, meta: l.periodText + " · " + l.start + "–" + l.end + " · " + l.lengthText, lines: lines };
}

function section_(title, items) {
  if (!items.length) return null;
  var html = '<h2 style="font:600 13px/1.4 Arial,sans-serif;letter-spacing:.06em;text-transform:uppercase;color:#7a6f5f;margin:28px 0 8px">' + esc_(title) + "</h2>" +
    items.map(function (it) {
      return '<div style="border-left:3px solid #c9bda9;padding:6px 0 6px 12px;margin:0 0 12px">' +
        '<div style="font:600 16px/1.4 Georgia,serif;color:#1f2a44">' + esc_(it.title) +
        (it.meta ? ' <span style="font:400 13px Arial,sans-serif;color:#7a6f5f">' + esc_(it.meta) + "</span>" : "") + "</div>" +
        (it.lines || []).map(function (ln) {
          return '<div style="font:400 14px/1.5 Arial,sans-serif;color:#2b2b2b;margin-top:4px"><b style="color:#5b5245">' +
            esc_(ln[0]) + ":</b> " + multiline_(ln[1]) + "</div>";
        }).join("") + "</div>";
    }).join("");
  var text = title.toUpperCase() + "\n" + items.map(function (it) {
    return "- " + it.title + (it.meta ? " (" + it.meta + ")" : "") +
      (it.lines || []).map(function (ln) { return "\n    " + ln[0] + ": " + ln[1].replace(/\n/g, "\n    "); }).join("");
  }).join("\n");
  return { html: html, text: text };
}

function emailHtml_(heading, labels, sections, url) {
  return '<div style="background:#f6f1e7;padding:24px 12px"><div style="max-width:560px;margin:0 auto;background:#fffdf8;border:1px solid #e6dccb;border-radius:12px;padding:24px">' +
    '<div style="font:600 12px Arial,sans-serif;letter-spacing:.08em;text-transform:uppercase;color:#7a6f5f">' + esc_(APP_NAME) + " · Tomorrow</div>" +
    '<h1 style="font:600 24px/1.25 Georgia,serif;color:#1f2a44;margin:6px 0 4px">' + esc_(heading) + "</h1>" +
    (labels ? '<div style="font:400 14px Arial,sans-serif;color:#7a6f5f">' + esc_(labels) + "</div>" : "") +
    sections.map(function (s) { return s.html; }).join("") +
    (url ? '<p style="margin:28px 0 0"><a href="' + esc_(url) + '" style="font:600 14px Arial,sans-serif;color:#fffdf8;background:#1f2a44;padding:10px 16px;border-radius:8px;text-decoration:none">Open the app</a></p>' : "") +
    '<p style="font:400 12px Arial,sans-serif;color:#9a8f7f;margin:24px 0 0">You turned this email on in Settings. Turn it off there at any time.</p>' +
    "</div></div>";
}

// ===== apps-script/Marking.gs =====
/* Marking ("To mark"), class name lists, and the link to a teacher's own gradebook scoresheet.

   The scoresheet is the Google Sheets "Gradebook" template: on its Grades tab, class numbers are in
   column A and names in column B from row 6; each assignment is a column with its title in row 2 and
   full marks in row 3; the template's formulas only cover columns D–AA and rows 6–45. Writing is
   deliberately careful: the teacher sees a preview first, the app only ever fills a column that is
   completely empty, never touches rows 4–5 (the averages) or any cell with something in it, and stops
   when the gradebook is full instead of writing outside the formulas. */

var GRADEBOOK = { tab: "Grades", titleRow: 2, pointsRow: 3, firstRow: 6, lastRow: 45, firstCol: 4, lastCol: 27, noCol: 1, nameCol: 2 };
var HAND_IN_TEXT = { L: "Late", A: "Absent", M: "Missing" };
var SHEET_ID_PATTERN = /^[A-Za-z0-9_-]{20,100}$/;

// ---------- name lists ----------
function rostersByClass_() {
  var byClass = {};
  readTab_("Students").forEach(function (s) {
    (byClass[s.classId] = byClass[s.classId] || []).push({ no: Number(s.no), name: s.name });
  });
  Object.keys(byClass).forEach(function (k) { byClass[k].sort(function (a, b) { return a.no - b.no; }); });
  return byClass;
}

function requireClass_(classId) {
  if (!classIdSet_()[classId]) throw new UserError_("That class isn't in your list any more. Please reload the page.");
}

function writeRoster_(classId, roster) {
  var others = readTab_("Students").filter(function (s) { return s.classId !== classId; });
  replaceTab_("Students", others.concat(roster.map(function (s) { return { classId: classId, no: s.no, name: s.name }; })));
}

function saveRoster(classId, list) {
  return respond_(function () {
    return withLock_(function () {
      requireClass_(classId);
      var roster = cleanRoster_(list);
      writeRoster_(classId, roster);
      return { classId: classId, roster: roster };
    });
  });
}

// ---------- marking ----------
function saveMark(mark) {
  return respond_(function () {
    return withLock_(function () {
      var clean = cleanMark_(mark, classIdSet_(), today_());
      var existing = readTab_("Marks").filter(function (m) { return m.id === clean.id; })[0];
      if (!existing && readTab_("Marks").length >= LIMITS.marks) throw new UserError_("You've reached the limit of " + LIMITS.marks + " marking items. Delete some finished ones first.");
      // Which scoresheet column it was written to is the web app's own record, never the page's.
      if (existing) clean.sheetCol = existing.sheetCol || "";
      return { mark: upsert_("Marks", idKey_, clean) };
    });
  });
}

function deleteMark(id) {
  return respond_(function () {
    return withLock_(function () { return { removed: remove_("Marks", idKey_, cleanId_(id)) }; });
  });
}

// ---------- scoresheet ----------
function sheetIdFrom_(text) {
  var s = String(text || "").trim();
  var m = s.match(/\/spreadsheets\/d\/([A-Za-z0-9_-]{20,100})/);
  var id = m ? m[1] : s;
  if (!SHEET_ID_PATTERN.test(id)) throw new UserError_("That doesn't look like a Google Sheets link. Copy the address from the scoresheet's browser tab.");
  return id;
}

function openGradebook_(id) {
  var book;
  try {
    book = SpreadsheetApp.openById(id);
  } catch (e) {
    console.warn("Scoresheet " + id + " could not be opened: " + (e && e.message || e));
    throw new UserError_("The app can't open that scoresheet. In the scoresheet, press Share and add " +
      Session.getEffectiveUser().getEmail() + " as an Editor, then try again. If your school doesn't allow that, use Copy column instead.");
  }
  var sheet = book.getSheetByName(GRADEBOOK.tab);
  if (!sheet) throw new UserError_("That scoresheet has no tab called “" + GRADEBOOK.tab + "”. The app works with the Gradebook template.");
  return sheet;
}

function gradebookRows_() { return GRADEBOOK.lastRow - GRADEBOOK.firstRow + 1; }

// The students listed on the Grades tab: [{no, name, row}].
function gradebookRoster_(sheet) {
  var values = sheet.getRange(GRADEBOOK.firstRow, 1, gradebookRows_(), GRADEBOOK.nameCol).getValues();
  var list = [];
  values.forEach(function (r, i) {
    var no = Number(r[GRADEBOOK.noCol - 1]);
    var name = String(r[GRADEBOOK.nameCol - 1] || "").trim();
    if (no >= 1 && no <= 99 && Math.floor(no) === no && name) list.push({ no: no, name: name.slice(0, LIMITS.studentName), row: GRADEBOOK.firstRow + i });
  });
  return list;
}

function scoresheetIdFor_(classId) {
  var id = (readSettings_().scoresheets || {})[classId];
  if (!id) throw new UserError_("This class has no scoresheet linked yet. Add it in Settings → Name lists.");
  return id;
}

// Links a class to its scoresheet and takes the class's name list from it.
function linkScoresheet(classId, link) {
  return respond_(function () {
    return withLock_(function () {
      requireClass_(classId);
      var id = sheetIdFrom_(link);
      var roster = gradebookRoster_(openGradebook_(id)).map(function (s) { return { no: s.no, name: s.name }; });
      if (!roster.length) throw new UserError_("No students were found on the Grades tab (class numbers in column A and names in column B, from row 6).");
      var clean = cleanRoster_(roster);
      var sheets = Object.assign({}, readSettings_().scoresheets || {});
      sheets[classId] = id;
      writeSetting_("scoresheets", sheets);
      writeRoster_(classId, clean);
      return { classId: classId, roster: clean };
    });
  });
}

function unlinkScoresheet(classId) {
  return respond_(function () {
    return withLock_(function () {
      var sheets = Object.assign({}, readSettings_().scoresheets || {});
      delete sheets[classId];
      writeSetting_("scoresheets", sheets);
      return { classId: classId };
    });
  });
}

function columnLetter_(n) {
  var s = "";
  for (; n > 0; n = Math.floor((n - 1) / 26)) s = String.fromCharCode(65 + ((n - 1) % 26)) + s;
  return s;
}

function cellIsBlank_(value, formula) { return (value === "" || value === null) && !formula; }

// The first assignment column whose title, full marks and every student cell are all empty.
function emptyGradebookColumn_(sheet) {
  var width = GRADEBOOK.lastCol - GRADEBOOK.firstCol + 1;
  var head = sheet.getRange(GRADEBOOK.titleRow, GRADEBOOK.firstCol, 2, width);
  var body = sheet.getRange(GRADEBOOK.firstRow, GRADEBOOK.firstCol, gradebookRows_(), width);
  var hv = head.getValues(), hf = head.getFormulas(), bv = body.getValues(), bf = body.getFormulas();
  for (var c = 0; c < width; c++) {
    var blank = [0, 1].every(function (r) { return cellIsBlank_(hv[r][c], hf[r][c]); }) &&
      bv.every(function (row, r) { return cellIsBlank_(row[c], bf[r][c]); });
    if (blank) return GRADEBOOK.firstCol + c;
  }
  return 0;
}

function cleanFullMarks_(value) {
  if (value === undefined || value === null || value === "") return "";
  var n = Number(value);
  if (!(n > 0 && n <= 1000)) throw new UserError_("Full marks must be a number from 1 to 1000.");
  return n;
}

// What a write would do, without doing it.
function scoresheetPlan_(markId, fullMarks) {
  var mark = readTab_("Marks").filter(function (m) { return m.id === markId; })[0];
  if (!mark) throw new UserError_("That marking item isn't there any more. Please reload the page.");
  if (!mark.classId) throw new UserError_("Choose the class for this marking first.");
  if (mark.sheetCol) throw new UserError_("This marking was already written to column " + mark.sheetCol + " of the scoresheet.");
  var sheet = openGradebook_(scoresheetIdFor_(mark.classId));
  var col = emptyGradebookColumn_(sheet);
  if (!col) throw new UserError_("The scoresheet's assignment columns (D to AA) are all used, so nothing was written. Make room there, or start a new gradebook.");
  var roster = gradebookRoster_(sheet);
  var students = mark.students || {};
  var inSheet = Object.create(null);
  var cells = roster.map(function (s) {
    inSheet[s.no] = true;
    var st = students[String(s.no)] || {};
    return { row: s.row, no: s.no, name: s.name, value: HAND_IN_TEXT[st.s] || "", unrecorded: !st.s };
  });
  return {
    mark: mark, sheet: sheet, col: col, column: columnLetter_(col),
    title: mark.title + (mark.collected ? " (" + logic_().shortDate(mark.collected) + ")" : ""),
    fullMarks: cleanFullMarks_(fullMarks),
    cells: cells,
    missingFromSheet: Object.keys(students).filter(function (no) { return !inSheet[no]; }).map(Number)
  };
}

function previewScoresheet(markId, fullMarks) {
  return respond_(function () {
    var plan = scoresheetPlan_(cleanId_(markId), fullMarks);
    return {
      column: plan.column, title: plan.title, fullMarks: plan.fullMarks,
      cells: plan.cells.map(function (c) { return { no: c.no, name: c.name, value: c.value, unrecorded: c.unrecorded }; }),
      missingFromSheet: plan.missingFromSheet
    };
  });
}

// Writes only after the teacher saw the preview for this exact column; if the sheet changed since
// (someone typed in that column), nothing is written and they're asked to look again.
function writeScoresheet(markId, column, fullMarks) {
  return respond_(function () {
    return withLock_(function () {
      var plan = scoresheetPlan_(cleanId_(markId), fullMarks);
      if (plan.column !== column) throw new UserError_("The scoresheet changed since the preview (column " + column + " isn't empty any more). Please preview again.");
      // As plain text, so a title like "1/2" or "=x" isn't turned into a date or formula.
      plan.sheet.getRange(GRADEBOOK.titleRow, plan.col).setNumberFormat("@").setValue(plan.title);
      if (plan.fullMarks !== "") plan.sheet.getRange(GRADEBOOK.pointsRow, plan.col).setValue(plan.fullMarks);
      var written = 0;
      plan.cells.forEach(function (c) {
        if (!c.value) return;
        plan.sheet.getRange(c.row, plan.col).setValue(c.value);
        written++;
      });
      var saved = upsert_("Marks", idKey_, Object.assign({}, plan.mark, { sheetCol: plan.column }));
      return { mark: saved, column: plan.column, written: written };
    });
  });
}
